# Supabase CLI local state — supabase/.temp/pooler-url contains a live
# database connection string with credentials; supabase/.temp in general is
# machine-local CLI cache, not project source. supabase/config.toml (outside
# .temp) IS meant to be committed.
supabase/.temp/
.supabase-token

